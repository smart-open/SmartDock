<Window x:Class="Platform.Client.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Platform.Client.Controls"
        Title="SmartDock 看板大屏" WindowStyle="None" WindowState="Maximized"
        Background="{StaticResource BgBaseBrush}" FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True" PreviewKeyDown="OnPreviewKeyDown">
    <!-- S07 挂墙大屏：全屏无边框；Esc 退出；断线显示「数据已过期」（图上脚注约定） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- 顶栏：车间/班次 | 日期 | 大时钟 | 连接点（挂墙大屏图头部） -->
        <Border Grid.Row="0" Background="#0A1016" BorderBrush="#1E4A5A" BorderThickness="0,0,0,2">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SmartDock 生产看板" FontSize="22" FontWeight="Bold"
                           Foreground="#25D6E8" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ShiftText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="28,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="ClockText" FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="34" FontWeight="Bold" Foreground="#FFFFFF" TextAlignment="Center"
                           VerticalAlignment="Center" Text="--:--:--" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="14" Height="14"
                             Fill="{StaticResource StateGoodBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="FooterStatusText" Text="每秒刷新" Style="{StaticResource SecondaryText}"
                               FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 断线横幅：默认收起 -->
        <Border Grid.Row="1" x:Name="StaleBanner" Background="#3A171B" BorderBrush="{StaticResource StateBadBrush}"
                BorderThickness="0,0,0,1" Visibility="Collapsed" Padding="16,8">
            <TextBlock x:Name="StaleText" Text="数据已过期" Foreground="{StaticResource StateBadBrush}"
                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
        </Border>

        <!-- 主体面板 -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 可用率环形仪表 -->
                <Border Grid.Column="0" Style="{StaticResource BracketCardBorder}" Width="300" Height="240" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="点位可用率" Style="{StaticResource CardTitleText}" HorizontalAlignment="Center" />
                        <controls:DonutGauge x:Name="AvailabilityGauge" Width="200" Height="180"
                                             ValueBrush="{StaticResource AccentCyanBrush}" />
                        <TextBlock x:Name="AvailabilityDetailText" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" Text="正常 -- / 总 --" />
                    </StackPanel>
                </Border>

                <!-- 近期正常数趋势 -->
                <Border Grid.Column="1" Style="{StaticResource BracketCardBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="近期点位正常数趋势" Style="{StaticResource CardTitleText}" Margin="0,0,0,4" />
                        <controls:TrendChart Grid.Row="1" x:Name="TrendPanel" SeriesBrush="{StaticResource AccentCyanBrush}" />
                    </Grid>
                </Border>

                <!-- 当前报警（红语义面板） -->
                <Border Grid.Column="2" Style="{StaticResource BracketCardBorder}" Width="420"
                        BorderBrush="#6B2430" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="当前报警" Style="{StaticResource CardTitleText}"
                                   Foreground="{StaticResource StateBadBrush}" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" x:Name="AlarmPanel" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 设备状态点阵：每设备一枚圆点（绿=启用 灰=停用），悬停看编码 -->
            <Border Grid.Row="1" Style="{StaticResource BracketCardBorder}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="设备状态" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DeviceDots">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部脚注（图上约定：每秒刷新 · 断线显示数据已过期） -->
        <Border Grid.Row="3" Background="#0A1016" BorderBrush="#1E4A5A" BorderThickness="0,2,0,0">
            <TextBlock x:Name="BottomFootnote" Style="{StaticResource SecondaryText}" FontSize="12"
                       Margin="20,0" VerticalAlignment="Center" Text="每秒刷新 · 断线显示数据已过期 · Esc 退出全屏" />
        </Border>
    </Grid>
</Window>
