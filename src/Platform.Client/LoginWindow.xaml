<Window x:Class="Platform.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDock 登录" Height="560" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBaseBrush}" FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True">
    <!-- S00 登录卡：深底 + 淡网格暗纹 + 居中登录卡 + 版本/授权脚注 -->
    <Grid>
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Geometry="M0,0 L40,0 40,40 0,40 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#14FFFFFF" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.4*" />
            </Grid.RowDefinitions>

            <!-- 登录卡 -->
            <Border Grid.Row="1" Width="360" Style="{StaticResource CardBorder}" Padding="28,26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="SmartDock" FontSize="22" FontWeight="Bold" Foreground="#25D6E8" />
                    </StackPanel>
                    <TextBlock Text="智舱 · 工业设备接入平台" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

                    <TextBlock Text="工号" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                    <TextBox x:Name="UserCodeBox" KeyDown="OnKeyDown" Margin="0,0,0,12" />

                    <TextBlock Text="口令" Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox" KeyDown="OnKeyDown" Margin="0,0,0,20" />

                    <Button x:Name="LoginButton" Content="登 录" Style="{StaticResource PrimaryButton}"
                            Height="36" Click="OnLoginClick" IsDefault="True" />
                    <TextBlock Text="连续 5 次失败将锁定 15 分钟" Style="{StaticResource SecondaryText}"
                               FontSize="11" Margin="0,10,0,0" />

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource StateBadBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部脚注：版本 + 授权状态（LicenseApiClient 失败时降级为仅版本号） -->
        <TextBlock Grid.Row="0" x:Name="FooterText" Text="SmartDock" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" />
    </Grid>
</Window>
