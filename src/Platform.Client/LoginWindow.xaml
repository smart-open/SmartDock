<Window x:Class="Platform.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDock 登录" Height="300" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SmartDock 上位机" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" />

        <TextBlock Grid.Row="1" Text="工号" Margin="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="UserCodeBox" Padding="4" Margin="0,0,0,12" KeyDown="OnKeyDown" />

        <TextBlock Grid.Row="3" Text="口令" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="4" x:Name="PasswordBox" Padding="4" KeyDown="OnKeyDown" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LoginButton" Content="登录" Width="90" Padding="6,4" Click="OnLoginClick" IsDefault="True" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="ErrorText" Foreground="Red" VerticalAlignment="Bottom"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Window>
