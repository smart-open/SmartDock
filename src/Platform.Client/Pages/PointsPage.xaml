<UserControl x:Class="Platform.Client.Pages.PointsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="刷新快照" Padding="12,4" Click="OnRefreshClick" />
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Text="就绪" />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="SnapshotGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PointId" Binding="{Binding PointId}" Width="80" />
                <DataGridTextColumn Header="值" Binding="{Binding ValueText}" Width="140" />
                <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="90" />
                <DataGridTextColumn Header="时间(本地)" Binding="{Binding TimestampText}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
