<UserControl x:Class="Platform.Client.Pages.AlarmsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="刷新" Padding="12,4" Click="OnRefreshClick" />
            <CheckBox x:Name="ActiveOnlyCheck" Content="仅未清" IsChecked="True" Margin="12,0,0,0"
                      VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Text="就绪" />
        </StackPanel>

        <!-- C3 确认页主视图：等级 3=严重(红) 2=警告(橙) 1=提示(灰)；未确认加粗 -->
        <DataGrid Grid.Row="1" x:Name="AlarmGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="等级" Binding="{Binding LevelText}" Width="70" />
                <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="70" />
                <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="140" />
                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" />
                <DataGridTextColumn Header="触发时间" Binding="{Binding RaisedText}" Width="150" />
                <DataGridTextColumn Header="确认状态" Binding="{Binding AckText}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AckButton" Content="确认选中报警" Padding="12,4" Click="OnAckClick" />
            <TextBlock x:Name="AckHint" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="确认将记录操作人与时间（C3）" Foreground="Gray" />
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
