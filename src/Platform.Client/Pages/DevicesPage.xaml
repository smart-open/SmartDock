<UserControl x:Class="Platform.Client.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="刷新设备" Padding="12,4" Click="OnRefreshClick" />
            <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" Text="就绪" />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DeviceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编码" Binding="{Binding DeviceCode}" Width="110" />
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="驱动" Binding="{Binding DriverId}" Width="150" />
                <DataGridTextColumn Header="周期(ms)" Binding="{Binding PollMs}" Width="80" />
                <DataGridTextColumn Header="点位数" Binding="{Binding PointCount}" Width="70" />
                <DataGridTextColumn Header="启用" Binding="{Binding EnabledText}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
