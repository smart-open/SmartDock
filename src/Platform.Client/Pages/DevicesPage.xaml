<UserControl x:Class="Platform.Client.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- S02 设备台账（只读段）：标题 + 状态灯表格（增删改随 M3 device:manage） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="18" Background="{StaticResource AccentCyanBrush}"
                        CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="设备台账" Style="{StaticResource CardTitleText}" FontSize="15"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新" Padding="14,4"
                    HorizontalAlignment="Right" Click="OnRefreshClick" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" AlternationCount="2"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编码" Binding="{Binding DeviceCode}" Width="110"
                                        ElementStyle="{StaticResource MonoTextElement}" />
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="驱动" Binding="{Binding DriverId}" Width="150"
                                        ElementStyle="{StaticResource MonoTextElement}" />
                    <DataGridTextColumn Header="周期(ms)" Binding="{Binding PollMs}" Width="80"
                                        ElementStyle="{StaticResource MonoTextElement}" />
                    <DataGridTextColumn Header="点位数" Binding="{Binding PointCount}" Width="70"
                                        ElementStyle="{StaticResource MonoTextElement}" />
                    <DataGridTemplateColumn Header="启用" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{Binding EnabledBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding EnabledText}" FontSize="12"
                                               Foreground="{Binding EnabledBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Height" Value="30" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{StaticResource BgPanelAltBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" Text="就绪" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource StateBadBrush}" Margin="24,0,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
