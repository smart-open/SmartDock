<UserControl x:Class="Platform.Client.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="报表：" VerticalAlignment="Center" />
            <ComboBox x:Name="ReportCombo" Width="220" SelectionChanged="OnReportSelected" />
            <TextBlock Text="  起：" VerticalAlignment="Center" Margin="16,0,0,0" />
            <DatePicker x:Name="FromDate" Width="130" />
            <TextBlock Text="  止：" VerticalAlignment="Center" />
            <DatePicker x:Name="ToDate" Width="130" />
            <Button x:Name="QueryButton" Content="查询" Padding="12,4" Margin="16,0,0,0" Click="OnQueryClick" />
            <Button x:Name="ExportButton" Content="导出 xlsx" Padding="12,4" Margin="8,0,0,0" Click="OnExportClick" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,0,0,6" Foreground="Gray" Text="选择报表后查询" />

        <DataGrid Grid.Row="2" x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" />

        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
