<UserControl x:Class="Platform.Client.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- S06 报表查看：参数区 + 结果表（8.2 编译链路；样式统一走 DarkTheme） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="3" Height="18" Background="{StaticResource AccentCyanBrush}"
                    CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="报表" Style="{StaticResource CardTitleText}" FontSize="15"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="报表" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <ComboBox x:Name="ReportCombo" Width="220" Margin="8,0,0,0" SelectionChanged="OnReportSelected" />
                <TextBlock Text="起" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="16,0,6,0" />
                <DatePicker x:Name="FromDate" Width="130" />
                <TextBlock Text="止" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <DatePicker x:Name="ToDate" Width="130" />
                <Button x:Name="QueryButton" Content="查询" Style="{StaticResource PrimaryButton}"
                        Padding="16,4" Margin="16,0,0,0" Click="OnQueryClick" />
                <Button x:Name="ExportButton" Content="导出 xlsx" Padding="12,4" Margin="8,0,0,0" Click="OnExportClick" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,0,0,6" Style="{StaticResource SecondaryText}"
                   Text="选择报表后查询" />

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0" AlternationCount="2"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Height" Value="30" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="{StaticResource BgPanelAltBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource StateBadBrush}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
