<Window x:Class="Platform.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDock" Height="640" Width="1020"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航：M1 两页（设备/点位）；报警/报表随 M3 -->
        <StackPanel Grid.Column="0" Background="#F0F0F0">
            <TextBlock x:Name="SessionText" Margin="12,12,12,20" TextWrapping="Wrap" FontWeight="Bold" />
            <Button x:Name="NavDevicesButton" Content="设备" Height="36" Margin="8,4"
                    HorizontalContentAlignment="Left" Padding="12,0" Click="OnNavDevicesClick" />
            <Button x:Name="NavPointsButton" Content="点位" Height="36" Margin="8,4"
                    HorizontalContentAlignment="Left" Padding="12,0" Click="OnNavPointsClick" />
        </StackPanel>

        <!-- 右侧内容区：两页共享一个 ContentControl，按导航切换 -->
        <ContentControl Grid.Column="1" x:Name="PageHost" Margin="12" />
    </Grid>
</Window>
